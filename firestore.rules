
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permite leitura e escrita pública para a coleção de relatórios
    // Isso garante que qualquer dispositivo possa ver e salvar no histórico global
    match /reports/{reportId} {
      allow read, write: if true;
    }
    
    // Nega acesso a qualquer outra coleção por segurança
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
